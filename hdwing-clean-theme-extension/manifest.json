{
  "manifest_version": 3,
  "name": "hdchina清爽主题",
  "version": "2.39.0",
  "description": "HDWinG 全站清爽主题：白底、蓝色导航、置顶淡蓝行、清晰网格。首帧防闪、样式常驻，比油猴版更稳定。",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["scripting", "activeTab", "tabs"],
  "host_permissions": ["*://hdwing.org/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "hdchina清爽主题 · 设置",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://hdwing.org/*"],
      "css": ["flash-guard.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
